<% layout('layouts/boilerplate') %>

<div class="container py-5">

    <!-- Title Section -->
    <div class="mb-4">
        <h1 class="display-6 fw-bold text-success">
            Yoga Posture Correction
        </h1>
        <p class="text-muted">
            Use computer vision to perfect your asanas and practice with proper alignment
        </p>
    </div>

    <!-- How It Works -->
    <div class="card border-success mb-5" style="border-radius: 12px;">
        <div class="card-body">
            <h6 class="fw-bold">
                <i class="bi bi-chevron-down me-2"></i> How It Works
            </h6>
            <p class="small text-muted">
                This tool uses MediaPipe Pose to detect body key points in real-time and provide posture feedback.
            </p>
            <ol class="small text-muted">
                <li>Click "Start Camera"</li>
                <li>Ensure full body is visible</li>
                <li>Click "Start Detection"</li>
            </ol>
        </div>
    </div>

    <div class="row g-4">

        <!-- CAMERA SECTION -->
        <div class="col-md-6">
            <div class="card shadow-sm" style="border-radius: 14px;">
                <div class="card-body">
                    <h6 class="fw-bold">Camera Feed</h6>
                    <p class="small text-muted">Position yourself in frame</p>

                    <!-- Video + Canvas -->
                    <div class="position-relative rounded overflow-hidden"
                         style="height: 400px; background: #000;">

                        <video id="video"
                               autoplay
                               playsinline
                               class="w-100 h-100"
                               style="object-fit: cover;">
                        </video>

                        <canvas id="canvas"
                                class="position-absolute top-0 start-0 w-100 h-100">
                        </canvas>
                    </div>

                    <!-- ✅ FIXED BUTTON ID -->
                    <button id="startBtn"
                            class="btn btn-success w-100 mt-3">
                        <i class="bi bi-camera-video me-2"></i>
                        Start Camera
                    </button>

                </div>
            </div>
        </div>

        <!-- POSE SECTION -->
        <div class="col-md-6">
            <div class="card shadow-sm" style="border-radius: 14px;">
                <div class="card-body">
                    <h6 class="fw-bold">Select Pose</h6>
                    <p class="small text-muted">Choose a yoga asana</p>

                    <select id="poseSelect" class="form-select">
                        <option selected disabled>Choose a pose</option>
                        <option value="tree">Tree Pose</option>
                        <option value="warrior">Warrior II</option>
                        <option value="mountain">Mountain Pose</option>
                        <option value="downdog">Downward Dog</option>
                    </select>

                    <!-- Optional detection button -->
                    <button id="startDetection"
                            class="btn btn-outline-success w-100 mt-3">
                        Start Detection
                    </button>

                    <div class="mt-4">
                        <h6 class="fw-bold">Feedback</h6>
                        <p id="feedback" class="text-muted">
                            Waiting to start...
                        </p>
                    </div>

                </div>
            </div>
        </div>

    </div>

</div>

<!-- MediaPipe Scripts (ORDER IMPORTANT) -->
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/pose/pose.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@mediapipe/drawing_utils/drawing_utils.js"></script>

<!-- Your Custom JS -->
<script src="/js/yogaPose.js"></script>