<% layout('layouts/boilerplate') %>

<style>
  :root {
    --white: #FFFFFF;
    --blue-chalk: #E9D4FF;
    --river-bed: #4A5565;
    --magnolia: #FAF5FF;
    --carousel-pink: #FDF2F8;
    --classic-rose: #FCCEE8;
    --athens-gray: #F3F3F5;
    --black-10: rgba(0, 0, 0, 0.1);
    --purple-gradient: linear-gradient(90deg, rgba(152,16,250,1) 0%, rgba(230,0,118,1) 100%);
  }

  main {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 32px 0 120px;
    gap: 32px;
  }

  .content {
    width: 100%;
    max-width: 1216px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .page-header h1 {
    font-size: 36px;
    font-weight: 400;
    background: var(--purple-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-header p {
    font-size: 13px;
    color: var(--river-bed);
  }

  .card-dharma {
    background: linear-gradient(177deg, #FAF5FF 0%, #FDF2F8 100%);
    border: 1px solid var(--blue-chalk);
    border-radius: 14px;
    padding: 24px;
  }

  .text-cards-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 12px;
  }

  .text-card {
    padding: 12px;
    border-radius: 10px;
  }

  .gita {
    background: var(--magnolia);
    border: 1px solid var(--blue-chalk);
  }

  .sutras {
    background: var(--carousel-pink);
    border: 1px solid var(--classic-rose);
  }

  .ask-section {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tabs-container {
    display: flex;
    background: var(--athens-gray);
    border-radius: 14px;
    padding: 3px;
    width: fit-content;
  }

  .tab {
    padding: 6px 40px;
    border-radius: 14px;
    border: none;
    background: transparent;
    cursor: pointer;
  }

  .tab.active {
    background: white;
  }

  .card-ask {
    background: white;
    border: 1px solid var(--black-10);
    border-radius: 14px;
    padding: 24px;
  }

  textarea {
    width: 100%;
    padding: 10px;
    background: var(--athens-gray);
    border-radius: 8px;
    border: none;
    resize: vertical;
  }

  .btn-seek {
    margin-top: 10px;
    width: 100%;
    padding: 10px;
    border-radius: 8px;
    border: none;
    color: white;
    background: var(--purple-gradient);
    cursor: pointer;
  }

  .example-btn {
    width: 100%;
    padding: 12px;
    border-radius: 8px;
    border: 1px solid var(--black-10);
    background: white;
    margin-top: 8px;
    text-align: left;
    cursor: pointer;
  }

  .example-btn:hover {
    background: var(--athens-gray);
  }

  .answer-box {
    margin-top: 20px;
    padding: 16px;
    background: var(--magnolia);
    border-radius: 10px;
    border: 1px solid var(--blue-chalk);
  }

  @media (max-width: 1024px) {
    .text-cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<main>
  <div class="content">

    <section class="page-header">
      <h1>SAARATHI</h1>
      <p>Seek ethical guidance inspired by the Bhagavad Gita and Yoga Sutras</p>
    </section>

    <section class="card-dharma">
      <h4>What is Dharma?</h4>
      <p><strong>Dharma (धर्म)</strong> means righteousness, duty, and harmony with universal principles.</p>
      <p>This guide draws wisdom from two timeless texts:</p>

      <div class="text-cards-grid">
        <div class="text-card gita">
          <h4>Bhagavad Gita</h4>
          <p>A 700-verse dialogue on duty, action, and reality</p>
        </div>

        <div class="text-card sutras">
          <h4>Yoga Sutras</h4>
          <p>Patanjali's 196 aphorisms on the path to self-realization</p>
        </div>
      </div>
    </section>

    <section class="ask-section">

      <div class="tabs-container">
        <button class="tab active">Ask for Guidance</button>
        <button class="tab">Browse Teachings</button>
      </div>

      <div class="card-ask">
        <h4>Ask Your Question</h4>
        <p style="color:#717182; font-size:13px;">
          Share your dilemma or life question. The guide will respond with wisdom from ancient texts.
        </p>

        <!-- ✅ FIXED FORM ACTION -->
        <form method="POST" action="/saarathi">
          <textarea 
            name="question"
            placeholder="What ethical or life question are you facing?"
            rows="3"
            required
          ></textarea>

          <button type="submit" class="btn-seek">
            Seek Guidance
          </button>
        </form>

        <!-- ✅ SHOW ANSWER -->
        <% if (answer) { %>
          <div class="answer-box">
            <pre style="white-space: pre-wrap; font-family: inherit;"><%= answer %></pre>
          </div>
        <% } %>

        <div style="margin-top:20px;">
          <p style="font-size:13px; color:#4A5565;">Try these example questions:</p>

          <button type="button" class="example-btn">I feel stressed about work deadlines. How can I find peace?</button>
          <button type="button" class="example-btn">How do I make the right ethical decision when both choices seem difficult?</button>
          <button type="button" class="example-btn">I struggle with procrastination. What does yoga philosophy say about this?</button>
          <button type="button" class="example-btn">How can I be more content with what I have?</button>
        </div>

      </div>

    </section>

  </div>
</main>

<script>
  const examples = document.querySelectorAll(".example-btn");
  const textarea = document.querySelector("textarea");

  examples.forEach(btn => {
    btn.addEventListener("click", () => {
      textarea.value = btn.innerText;
      textarea.focus();
    });
  });
</script>