<% layout('layouts/boilerplate') %>

<div class="auth-card">

    <h2 class="text-center mb-4">Welcome Back</h2>

    <form action="/login" method="POST">

        <div class="mb-3">
            <input type="text" 
                   name="username" 
                   class="form-control" 
                   placeholder="Username" required>
        </div>

        <div class="mb-3">
            <input type="password" 
                   name="password" 
                   class="form-control" 
                   placeholder="Password" required>
        </div>

        <button class="btn btn-green w-100">
            Login
        </button>

    </form>

</div>